[Unit]
Description=FaceGate approval HUD for Gaze authentication
# Start with Plasma itself, never at boot: with lingering, default.target runs
# before any display exists, and anything can pull graphical-session.target
# early, so the island crash-loops until systemd gives up on it.
After=graphical-session.target plasma-kwin_wayland.service
PartOf=graphical-session.target
Wants=facegate-tray.service
Before=facegate-tray.service

[Service]
Type=simple
Environment=GDK_BACKEND=wayland
# gtk4-layer-shell must be present before GTK opens its Wayland connection or
# it cannot install the layer-shell surface role from Python introspection.
Environment=LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so.0
# The starlight enrollment preview is built from GTK render nodes.
Environment=GSK_RENDERER=vulkan
ExecStart=/usr/local/bin/facegate-hud
Restart=on-failure
RestartSec=2

[Install]
WantedBy=plasma-workspace.target
