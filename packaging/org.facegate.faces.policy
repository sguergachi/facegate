<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>FaceGate</vendor>
  <vendor_url>https://github.com/sguergachi/facegate</vendor_url>
  <action id="org.facegate.list-faces">
    <description>See the faces that can approve for you</description>
    <message>See the faces that can approve for you.</message>
    <icon_name>user-identity</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/facegate/facegate-faces-list</annotate>
  </action>
  <action id="org.facegate.manage-faces">
    <description>Change the faces that can approve for you</description>
    <message>Approve to change the faces that can unlock admin access.</message>
    <icon_name>user-identity</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/facegate/facegate-faces</annotate>
  </action>
</policyconfig>
