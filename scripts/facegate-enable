#!/usr/bin/env bash
# Per-user activation: make FaceGate the session's polkit agent and start it.
set -euo pipefail
if [[ ${EUID} -eq 0 ]]; then
  echo "Run facegate-enable as your normal user, not root." >&2
  exit 1
fi
# Desktop polkit agents shipped as user units. Agents that autostart some other
# way (GNOME's autostart entry, distro scripts) keep running and may prompt
# alongside the island; run with --disable to go back to stock behavior.
agents=(
  plasma-polkit-agent.service
  hyprpolkitagent.service
  polkit-gnome-authentication-agent-1.service
)
if [[ ${1:-} == --disable ]]; then
  systemctl --user disable --now facegate.service facegate-tray.service 2>/dev/null || true
  for agent in "${agents[@]}"; do
    systemctl --user unmask "${agent}" 2>/dev/null || true
    systemctl --user start "${agent}" 2>/dev/null || true
  done
  echo "FaceGate disabled for this user; the desktop polkit agent is restored."
  exit 0
fi
systemctl --user daemon-reload
for agent in "${agents[@]}"; do
  systemctl --user stop "${agent}" 2>/dev/null || true
  systemctl --user mask "${agent}" >/dev/null 2>&1 || true
done
systemctl --user enable --now facegate.service
systemctl --user restart facegate.service
echo "FaceGate is active. Test with: sudo -k; sudo -v"
echo "Manage faces from the FaceGate app, or run: facegate-settings"
